{
  "manifest_version": 3,
  "name": "AIWorkerNotifier ChatGPT Watcher",
  "version": "0.1.6",
  "description": "Detects ChatGPT tabs and reports response-generation state to the local AIWorkerNotifier bridge without reading response text.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
